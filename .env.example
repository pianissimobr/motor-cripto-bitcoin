# ============================================================
# Motor Cripto - variaveis de ambiente (NUNCA commitar o .env)
# ============================================================

# --- Servidor HTTP ---
PORT=4578
HOST=0.0.0.0
NODE_ENV=development
# Token admin da API. Use um valor longo e aleatorio.
# Em producao prefira: ADMIN_TOKEN=$(openssl rand -hex 32)
ADMIN_TOKEN=troque-este-token-por-um-valor-aleatorio-longo
# Confiar em X-Forwarded-For? So habilite atras de um proxy reverso confiavel.
# Com false (default), o IP da auditoria/rate limit nao pode ser forjado.
TRUST_PROXY=false
# Expor documentacao OpenAPI? (json em /docs/openapi.json)
LOG_LEVEL=info

# --- Banco de dados ---
DATABASE_URL=postgres://motor:motor_dev_password@localhost:5432/motor_cripto
DATABASE_SSL=false
# PEM da CA quando DATABASE_SSL=true e o servidor nao usa uma CA publica.
# DATABASE_SSL_CA=
# Banco usado por `npm run test:integration` (criado/recriado pela suite;
# nunca aponte para o banco de desenvolvimento).
TEST_DATABASE_URL=postgres://motor:motor_dev_password@localhost:5432/motor_cripto_test

# --- Criptografia de dados ---
# Chave mestra de 32 bytes para AES-256-GCM (webhook secret, request secret e
# token da pagina de pagamento em repouso).
# Gere com: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# --- Rotacao de chaves (veja ENDURECIMENTO.md, frente E) ---
# Keyring de cifragem: JSON com 2+ chaves durante a rotacao.
# As chaves antigas CONTINUAM no keyring ate a rotacao terminar.
# KEYRING={"k1":"<base64 32>","k2":"<base64 32>"}
KEYRING=
# Chave usada nas novas escritas (deve existir no KEYRING).
DATA_ACTIVE_KID=k1
# Chave que cifrava os envelopes v1 (sem kid no cabecalho).
DATA_LEGACY_KID=k1

# --- HD Wallet ---
# XPUB DE CONTA (nivel m/44'/60'/0'). NEVER a master xpub (m/44') e nunca a seed.
# O xpub e um segredo: ele expoe o endereco de TODOS os enderecos derivados.
HD_XPUB=
# Caminho de derivacao RELATIVO a partir da conta. Padrao BIP44: m/44'/60'/0'/0/{index}
HD_DERIVATION_PREFIX=0
HD_ACCOUNT_INDEX=0
# Limite maximo de indices (evita derivacao infinita)
HD_MAX_INDEX=100000

# --- Signer ---
# local  = keystore cifrado local (padrao, desenvolvimento)
#          Em producao exige SIGNER_PASSPHRASE.
# remote = delega a assinatura a um servico HTTP externo (producao)
#          Em producao exige URL https.
# psbt   = apenas gera tx nao assinada (operador assina em hardware wallet)
#          O sweep fica pendente ate a assinatura manual.
SIGNER_MODE=local
# Caminho do keystore cifrado (modo local)
SIGNER_KEYSTORE_PATH=./data/keystore.json
# Senha do keystore (do cofre de segredos / secret manager em producao)
SIGNER_PASSPHRASE=
# Carteira patrocinadora de gas (envia POL para os enderecos derivados).
# A chave privada fica SO no worker. A API usa o endereco publico para o alerta de saldo.
GAS_SPONSOR_PRIVATE_KEY=
GAS_SPONSOR_ADDRESS=
# Quanto enviar por patrocinio (0,5 POL) e o piso que o destino precisa ter
# para nao patrocinar de novo. O piso deve ser <= ao envio.
GAS_SPONSOR_AMOUNT_WEI=500000000000000000
GAS_SPONSOR_MIN_BALANCE_WEI=100000000000000000
# URL do signer remoto (modo remote)
SIGNER_REMOTE_URL=
SIGNER_REMOTE_TOKEN=

# --- Blockchain ---
# RPCs publicas por chain (configure a sua / use Alchemy, Infura, QuickNode)
RPC_URL_POLYGON=https://polygon-bor-rpc.publicnode.com
RPC_URL_ARBITRUM=https://arbitrum-one-rpc.publicnode.com
RPC_URL_BASE=https://base-rpc.publicnode.com
RPC_URL_AMOY=https://rpc-amoy-bor.publicnode.com
# Numero de confirmacoes exigidas antes de confirmar o pagamento
CONFIRMATIONS_REQUIRED=10
# Tolerancia de valor (percentual). 1.0 = 1%
PAYMENT_TOLERANCE_PCT=1.0
# Intervalo do monitor em ms
MONITOR_INTERVAL_MS=15000
# Numero maximo de enderecos por eth_getLogs (topic filter)
MONITOR_MAX_TOPICS=200
# Faixa de blocos lida por ciclo
MONITOR_BLOCK_RANGE=2000
# Faixa inicial de blocos para bootstrap (evita varrer a chain inteira)
MONITOR_START_BLOCK=0
# C1: teto da varredura. `finalized` = so blocos com finalidade (Polygon PoS
# tem checkpoint, entao esses blocos nunca voltam). `latest` inclui blocos que
# ainda podem ser reescritos por um reorg.
MONITOR_BLOCK_TAG=finalized
# C2: intervalo em blocos entre duas ancoras de hash usadas para detectar reorg.
MONITOR_ANCHOR_INTERVAL=32
# Quantos blocos reler se um link aguardando tem saldo e o log passou batido.
MONITOR_BACKFILL_BLOCKS=100000
# RPC opcional de conferencia. Se existir, a confirmacao so sai quando os dois concordam.
# RPC_URL_POLYGON_CONFIRM=https://polygon-rpc.example

# --- Ramp ---
# Base URL padrão dos links Ramp (sem conta business = fluxo pessoal)
RAMP_BASE_URL=https://buy.ramp.network/
RAMP_PARAM_STYLE=legacy
RAMP_HOST_APP_NAME=Motor Cripto
RAMP_HOST_LOGO_URL=
# Moeda fiat padrao
RAMP_FIAT_CURRENCY=BRL
# URL publica usada para montar a pagina /p/:token
PUBLIC_BASE_URL=http://localhost:4578
# Tempo de vida da pagina/widget, em minutos
LINK_TTL_MINUTES=60
# Janela de verificacao on-chain depois que a pagina expira, em dias corridos
SETTLEMENT_DAYS=1
# Webhooks: timeout por tentativa e numero maximo de tentativas
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6

# --- Taxas do seed (base units do token por 1,00 de fiat) ---
# 180000 = 0,18 USDC por R$ 1,00. Atualize quando o cambio mudar e rode
# `npm run seed -- --update-rates` (ou use PATCH /admin/api/ramp-profiles/:id).
SEED_USDC_POR_BRL=180000
SEED_USDT_POR_BRL=180000
