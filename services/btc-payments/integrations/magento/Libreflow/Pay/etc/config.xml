<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <libreflow>
                <active>0</active>
                <model>Libreflow\Pay\Model\Payment\Libreflow</model>
                <title>Pix, Bitcoin ou USDC</title>
                <api_base>https://cripto.libreflowdigital.com</api_base>
                <store_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <ipn_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <order_status>pending_payment</order_status>
                <allowspecific>0</allowspecific>
                <sort_order>10</sort_order>
            </libreflow>
        </payment>
    </default>
</config>
