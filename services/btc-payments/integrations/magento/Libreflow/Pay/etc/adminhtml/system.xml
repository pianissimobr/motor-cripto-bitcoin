<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="payment">
            <group id="libreflow" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>LibreFlow Pay (Pix, Bitcoin e USDC)</label>
                <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1">
                    <label>Ativo</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1">
                    <label>Nome no checkout</label>
                </field>
                <field id="api_base" translate="label" type="text" sortOrder="3" showInDefault="1" showInWebsite="1">
                    <label>Endereço da API</label>
                </field>
                <field id="store_key" translate="label" type="obscure" sortOrder="4" showInDefault="1" showInWebsite="1">
                    <label>Chave de loja</label>
                    <comment>Painel LibreFlow → Integração e API. Comece pela chave de teste.</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="ipn_secret" translate="label" type="obscure" sortOrder="5" showInDefault="1" showInWebsite="1">
                    <label>Segredo IPN</label>
                    <comment>Endereço do aviso (IPN): https://SUA-LOJA/libreflow/ipn</comment>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="6" showInDefault="1" showInWebsite="1">
                    <label>Ordem</label>
                </field>
            </group>
        </section>
    </system>
</config>
