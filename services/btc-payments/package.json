{
  "name": "@motor-cripto/btc-payments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Servi\u00e7o de pagamentos Bitcoin: Lightning (LNbits) + on-chain watch-only (Esplora/Electrum)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx watch src/worker.ts",
    "worker:start": "node dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "alert:drill": "tsx src/tools/alert-drill.ts",
    "alert:drill:prod": "node dist/tools/alert-drill.js",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "client:create": "tsx scripts/seed-client.ts",
    "device:register": "tsx scripts/register-device.ts",
    "merchant:pix:seed": "tsx scripts/seed-pix-merchant.ts",
    "pix:e2e": "tsx scripts/pix-sandbox-e2e.ts",
    "pix:live": "tsx scripts/pix-live-charge.ts",
    "intent:create": "tsx scripts/create-intent.ts",
    "wallet:base:init": "tsx scripts/init-base-wallet.ts",
    "backup": "bash scripts/backup.sh",
    "backup:verify": "bash scripts/verify-backup.sh",
    "drills": "bash scripts/failure-drills.sh",
    "restore": "bash scripts/restore.sh"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^10.1.8",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "@scure/btc-signer": "^1.8.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "undici": "^7.12.0",
    "viem": "^2.57.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
