# ============================================================
# btc-payments - producao (use um secret manager sempre que possivel)
# ============================================================

DOMAIN=payments.example.com
NODE_ENV=production
PORT=4580
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_BASE_URL=https://payments.example.com
ADMIN_TOKEN=troque-por-32-chars-aleatorios
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=https://payments.example.com

# --- Postgres (usado pelo compose) ---
POSTGRES_USER=btc
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=btc_payments
DATABASE_URL=postgres://btc:troque-esta-senha@db:5432/btc_payments
DATABASE_SSL=false

# --- Criptografia ---
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Durante rotacao: JSON com as chaves antigas e a nova.
# KEYRING={"k1":"<base64 32>","k2":"<base64 32>"}
# DATA_ACTIVE_KID=k2
# DATA_LEGACY_KID=k1

# --- Bitcoin (sem carteira da plataforma) ---
# Lightning cai na wallet LNbits de cada lojista e on-chain nos enderecos do
# xpub dele (ambos cadastrados no portal). Nada e convertido.
BTC_NETWORK=bitcoin
BTC_DERIVATION_PREFIX=0
BTC_MAX_INDEX=100000
# Enderecos seguidos sem uso no xpub do lojista. O lojista configura o mesmo
# gap limit na carteira dele (Sparrow, Electrum...). No limite, a cobranca sai
# sem on-chain (so Lightning) ou e recusada com gap_limit_reached.
BTC_GAP_LIMIT=1000
INTENT_TTL_SECONDS=600
FX_QUOTE_TTL_SECONDS=600
INTENT_GRACE_SECONDS=86400

# --- LNbits ---
# false desliga o Lightning; deixe as variaveis vazias.
LIGHTNING_ENABLED=true
# O LNbits e o do lojista (cadastrado no portal). Aqui fica so o token que
# protege o webhook de entrada que as wallets dos lojistas chamam.
LNBITS_WEBHOOK_TOKEN=
LNBITS_WEBHOOK_BASE_URL=https://payments.example.com

# --- Esplora/Electrum self-hosted ---
# false desliga o on-chain; deixe as variaveis vazias.
ONCHAIN_ENABLED=true
ESPLORA_URL=http://esplora:3000
ESPLORA_TIMEOUT_MS=10000
ONCHAIN_CONFIRMATIONS=1
ONCHAIN_HIGH_VALUE_SATS=1000000
ONCHAIN_HIGH_VALUE_CONFIRMATIONS=3

# --- Rede Base (conferencia do PIX) ---
# A Lunium entrega o USDC do PIX direto na carteira usdc_settlement do
# lojista; o RPC so serve para conferir essa entrega on-chain.
BASE_RPC_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com
BASE_CHAIN_ID=8453
BASE_USDC_ADDRESS=0x833589fCD6EDB6E08F4C7C32D4f71b54BDA02913

# --- PIX -> USDC Base (Lunium) ---
# A Lunium entrega o USDC direto na carteira usdc_settlement do lojista.
# Desligado por padrao. Use lun_test_ no sandbox e lun_live_ em producao.
PIX_ENABLED=false
LUNIUM_API_URL=https://api.luniumpay.com
LUNIUM_API_KEY=
LUNIUM_WEBHOOK_SECRET=
LUNIUM_TIMEOUT_MS=15000
# A Lunium aceita 60 req/min por chave. `api` e `worker` sao processos
# separados: cada um segura a sua fatia e a soma nao passa do total.
# Pior caso por janela = rajada (5) + taxa, entao 20 + 25 + 10 = 55 < 60.
LUNIUM_RATE_LIMIT_MAX=50
LUNIUM_RATE_LIMIT_API_MAX=20
LUNIUM_RATE_LIMIT_WORKER_MAX=25
LUNIUM_RATE_LIMIT_WINDOW_MS=60000
LUNIUM_RATE_LIMIT_MAX_QUEUE=100
# Cache: o catalogo muda raremente, os limites do pagador mudam por uso.
LUNIUM_CATALOG_CACHE_MS=300000
LUNIUM_LIMITS_CACHE_MS=20000
PIX_ASSET=usdc
PIX_CHAIN=base
PIX_MIN_BRL_CENTS=2500
PIX_MAX_BRL_CENTS=25000000
PIX_VERIFY_SETTLEMENT_TX=true

# --- Webhooks / jobs / limites ---
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
JOBS_LIGHTNING_RECONCILE_MS=15000
JOBS_EXPIRY_POLL_MS=10000
JOBS_ONCHAIN_POLL_MS=15000
JOBS_WEBHOOK_POLL_MS=10000
JOBS_PIX_POLL_MS=30000
JOBS_PIX_BATCH_SIZE=30
JOBS_RECONCILIATION_MS=86400000
JOBS_BATCH_SIZE=50
# --- Metricas e alertas ---
# Token opcional para GET /metrics. Sem token, a rota fica aberta.
METRICS_TOKEN=
# ALERT_WEBHOOK_URL=https://alerts.example.com/btc-payments
# ALERT_WEBHOOK_TOKEN=
