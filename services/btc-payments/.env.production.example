# ============================================================
# btc-payments - producao (use um secret manager sempre que possivel)
# ============================================================

DOMAIN=payments.example.com
NODE_ENV=production
PORT=4580
HOST=0.0.0.0
LOG_LEVEL=info
PUBLIC_BASE_URL=https://payments.example.com
ADMIN_TOKEN=troque-por-32-chars-aleatorios
TRUST_PROXY=true
CORS_ALLOWED_ORIGINS=https://payments.example.com

# --- Postgres (usado pelo compose) ---
POSTGRES_USER=btc
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=btc_payments
DATABASE_URL=postgres://btc:troque-esta-senha@db:5432/btc_payments
DATABASE_SSL=false

# --- Criptografia ---
# openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Durante rotacao: JSON com as chaves antigas e a nova.
# KEYRING={"k1":"<base64 32>","k2":"<base64 32>"}
# DATA_ACTIVE_KID=k2
# DATA_LEGACY_KID=k1

# --- Bitcoin ---
BTC_NETWORK=bitcoin
# xpub DE CONTA BIP84 m/84'/0'/0' (depth 3), gerado por `npm run wallet:init`.
BTC_XPUB=
BTC_DERIVATION_PREFIX=0
BTC_MAX_INDEX=100000
BTC_GAP_LIMIT=20
INTENT_TTL_SECONDS=600
FX_QUOTE_TTL_SECONDS=600
INTENT_GRACE_SECONDS=86400

# --- LNbits ---
# false desliga o Lightning; deixe as variaveis vazias.
LIGHTNING_ENABLED=true
LNBITS_URL=https://lnbits.example.com
LNBITS_API_KEY=
LNBITS_WEBHOOK_TOKEN=
LNBITS_WEBHOOK_BASE_URL=https://payments.example.com

# --- Esplora/Electrum self-hosted ---
# false desliga o on-chain; deixe as variaveis vazias.
ONCHAIN_ENABLED=true
ESPLORA_URL=http://esplora:3000
ESPLORA_TIMEOUT_MS=10000
ONCHAIN_CONFIRMATIONS=1
ONCHAIN_HIGH_VALUE_SATS=1000000
ONCHAIN_HIGH_VALUE_CONFIRMATIONS=3

# --- Sweep ---
SWEEP_ENABLED=true
COLD_WALLET_ADDRESS=
TREASURY_BTC_ADDRESS=
TREASURY_USDC_ADDRESS=
GAS_BASE_ADDRESS=
SWEEP_MIN_SATS=1000
SWEEP_FEE_TARGET_BLOCKS=6
SWEEP_FEE_MULTIPLIER=1.0
SWEEP_MAX_FEE_PCT=0.1
SWEEP_RBF_AFTER_SECONDS=600
SWEEP_MAX_ATTEMPTS=3

# --- Signer ---
# remote = recomendado em producao (chave nao fica no host)
# local  = keystore cifrado no worker (exige o volume ./data)
# psbt   = assinatura manual
SIGNER_MODE=remote
SIGNER_REMOTE_URL=https://signer.example.com
SIGNER_REMOTE_TOKEN=
SIGNER_KEYSTORE_PATH=/app/data/keystore.json
SIGNER_PASSPHRASE=

# --- Conversao THORChain ---
CONVERSION_ENABLED=false
THORCHAIN_URLS=https://thornode.ninerealms.com,https://thornode.thorswap.net
THORCHAIN_TIMEOUT_MS=15000
CONVERSION_MIN_CONFIRMATIONS=3
CONVERSION_MIN_SATS=10000
CONVERSION_SLIPPAGE_BPS=100
CONVERSION_QUOTE_TOLERANCE_BPS=50
CONVERSION_MAX_ATTEMPTS=3
# Bridge HTTP que assina/gasta BTC da treasury; sem ele a conversao fica manual.
TREASURY_BTC_SIGNER_URL=
TREASURY_BTC_SIGNER_TOKEN=
# Bridge HTTP para sacar saldo Lightning da LNbits para a treasury BTC.
LNBITS_WITHDRAWAL_URL=
LNBITS_WITHDRAWAL_TOKEN=

# --- Payout Base USDC ---
PAYOUT_ENABLED=false
BASE_RPC_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com
BASE_CHAIN_ID=8453
BASE_USDC_ADDRESS=0x833589fCD6EDB6E08F4C7C32D4f71b54BDA02913
# Prefira PAYOUT_SIGNER_URL em producao; a chave nao deve ficar na API.
# BASE_PAYOUT_PRIVATE_KEY=
PAYOUT_HOT_ADDRESS=
PAYOUT_SIGNER_URL=
PAYOUT_SIGNER_TOKEN=
PAYOUT_CONFIRMATIONS=1
PAYOUT_NEW_WALLET_CARE_SECONDS=86400
PAYOUT_MAX_ATTEMPTS=3
PAYOUT_USD_BRL_RATE_CENTS=540
PAYOUT_MIN_GAS_WEI=100000000000000

# --- PIX -> USDC Base (Lunium) ---
# Desligado por padrao. Use lun_test_ no sandbox e lun_live_ em producao.
PIX_ENABLED=false
LUNIUM_API_URL=https://api.luniumpay.com
LUNIUM_API_KEY=
LUNIUM_WEBHOOK_SECRET=
LUNIUM_TIMEOUT_MS=15000
PIX_ASSET=usdc
PIX_CHAIN=base
PIX_MIN_BRL_CENTS=2500
PIX_MAX_BRL_CENTS=25000000
PIX_VERIFY_SETTLEMENT_TX=true

# --- Webhooks / jobs / limites ---
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
JOBS_LIGHTNING_RECONCILE_MS=15000
JOBS_EXPIRY_POLL_MS=10000
JOBS_ONCHAIN_POLL_MS=15000
JOBS_WEBHOOK_POLL_MS=10000
JOBS_SWEEP_POLL_MS=30000
JOBS_CONVERSION_POLL_MS=30000
JOBS_PAYOUT_POLL_MS=30000
JOBS_PIX_POLL_MS=30000
JOBS_RECONCILIATION_MS=86400000
JOBS_BATCH_SIZE=50
# --- Metricas e alertas ---
# Token opcional para GET /metrics. Sem token, a rota fica aberta.
METRICS_TOKEN=
# ALERT_WEBHOOK_URL=https://alerts.example.com/btc-payments
# ALERT_WEBHOOK_TOKEN=
