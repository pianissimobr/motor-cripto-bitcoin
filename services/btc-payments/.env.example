# ============================================================
# btc-payments - variaveis de ambiente (NUNCA commitar o .env)
# ============================================================

# --- Servidor HTTP ---
NODE_ENV=development
PORT=4580
HOST=0.0.0.0
LOG_LEVEL=debug
# Token do admin. Em producao: openssl rand -hex 32 (minimo 32 chars).
ADMIN_TOKEN=dev-admin-token-change-me
# So habilite atras de um proxy reverso confiavel.
TRUST_PROXY=false
# Lista separada por virgula, sem wildcard. Vazio = origem de PUBLIC_BASE_URL.
CORS_ALLOWED_ORIGINS=
PUBLIC_BASE_URL=http://localhost:4580

# --- Banco de dados ---
DATABASE_URL=postgres://btc:btc_dev_password@localhost:5434/btc_payments
DATABASE_SSL=false
TEST_DATABASE_URL=postgres://btc:btc_dev_password@localhost:5434/btc_payments_test
# DATABASE_SSL_CA=

# --- Criptografia de segredos ---
# Gere com: openssl rand -base64 32
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# KEYRING={"k1":"<base64 32>","k2":"<base64 32>"}
# DATA_ACTIVE_KID=k1
# DATA_LEGACY_KID=k1

# --- Bitcoin (sem carteira da plataforma) ---
# O dinheiro vai direto para as carteiras de cada lojista, cadastradas no
# portal: Lightning na wallet LNbits dele (URL + Invoice key) e on-chain nos
# enderecos derivados do xpub dele. Nao ha xpub, keystore nem carteira fria
# da plataforma, e nada e convertido.
# bitcoin | testnet | regtest
BTC_NETWORK=regtest
# Caminho relativo usado ao derivar os enderecos do xpub do lojista.
BTC_DERIVATION_PREFIX=0
BTC_MAX_INDEX=100000
# Enderecos seguidos sem uso no xpub do lojista. O lojista configura o mesmo
# gap limit na carteira dele (Sparrow, Electrum...). No limite, a cobranca sai
# sem on-chain (so Lightning) ou e recusada com gap_limit_reached.
BTC_GAP_LIMIT=1000

# --- Intent / expiracao ---
# Lightning expira em 10 min; on-chain continua observado por 24h.
INTENT_TTL_SECONDS=600
INTENT_GRACE_SECONDS=86400
# TTL da cotacao fiat/BTC no checkout.
FX_QUOTE_TTL_SECONDS=600

# --- On-chain / Esplora ---
# ONCHAIN_ENABLED=false desliga o trilho on-chain; deixe as variaveis vazias.
ONCHAIN_ENABLED=true
# Em dev, use Nigiri/Esplora self-hosted. Nao use API publica em producao.
ESPLORA_URL=http://localhost:3002
ESPLORA_TIMEOUT_MS=10000
ONCHAIN_CONFIRMATIONS=1
ONCHAIN_HIGH_VALUE_SATS=1000000
ONCHAIN_HIGH_VALUE_CONFIRMATIONS=3

# --- LNbits ---
# LIGHTNING_ENABLED=false desliga o Lightning; deixe as variaveis vazias.
LIGHTNING_ENABLED=true
# O LNbits e o do lojista (cadastrado no portal). Aqui fica so o token que
# protege o webhook de entrada que as wallets dos lojistas chamam.
LNBITS_WEBHOOK_TOKEN=dev-webhook-token-change-me
# URL que o container do LNbits usa para alcançar esta API (webhook de entrada).
# Fora do Docker, use a mesma PUBLIC_BASE_URL.
LNBITS_WEBHOOK_BASE_URL=http://host.docker.internal:4580

# --- Rede de liquidacao (conferencia do PIX) ---
# A Lunium entrega o USDC do PIX direto na carteira usdc_settlement do
# lojista; o RPC so serve para conferir essa entrega on-chain.
# A rede e a mesma de PIX_CHAIN (abaixo).
BASE_RPC_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com
BASE_CHAIN_ID=8453
BASE_USDC_ADDRESSES=0x833589fCD6EDB6E08F4C7C32D4f71b54BDA02913
POLYGON_RPC_URLS=https://polygon-rpc.com,https://polygon-bor-rpc.publicnode.com
POLYGON_CHAIN_ID=137
# Nativo (Circle) e bridged (USDC.e): a Lunium nao diz qual ela entrega, e a
# verificacao on-chain aceita os dois para a primeira entrega real nao cair
# em `manual`. Depois do primeiro hash real, deixe so o contrato certo.
POLYGON_USDC_ADDRESSES=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359,0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174

# --- PIX -> USDC Base (Lunium) ---
# A Lunium entrega o USDC direto na carteira usdc_settlement do lojista.
# Desligado por padrao. Use lun_test_ no sandbox e lun_live_ em producao.
PIX_ENABLED=false
LUNIUM_API_URL=https://api.luniumpay.com
LUNIUM_API_KEY=
LUNIUM_WEBHOOK_SECRET=
LUNIUM_TIMEOUT_MS=15000
# A Lunium aceita 60 req/min por chave. `api` e `worker` sao processos
# separados: cada um segura a sua fatia e a soma nao passa do total.
LUNIUM_RATE_LIMIT_MAX=50
LUNIUM_RATE_LIMIT_API_MAX=20
LUNIUM_RATE_LIMIT_WORKER_MAX=25
LUNIUM_RATE_LIMIT_WINDOW_MS=60000
LUNIUM_RATE_LIMIT_MAX_QUEUE=100
LUNIUM_CATALOG_CACHE_MS=300000
LUNIUM_LIMITS_CACHE_MS=20000
PIX_ASSET=usdc
PIX_CHAIN=polygon
PIX_MIN_BRL_CENTS=102
PIX_MAX_BRL_CENTS=600000
PIX_VERIFY_SETTLEMENT_TX=true

# --- Webhooks de saida ---
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6

# --- Rate limit ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Jobs do worker ---
JOBS_LIGHTNING_RECONCILE_MS=15000
JOBS_EXPIRY_POLL_MS=10000
JOBS_ONCHAIN_POLL_MS=15000
JOBS_WEBHOOK_POLL_MS=10000
JOBS_PIX_POLL_MS=30000
JOBS_PIX_BATCH_SIZE=30
JOBS_RECONCILIATION_MS=86400000
JOBS_BATCH_SIZE=50

# --- E-mail ---
# smtp = relay configurado (Postfix local ou provedor). Com noop, o token de
# redefinicao de senha e o aviso de troca de carteira NAO chegam ao lojista.
EMAIL_SENDER=noop
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASS=
SMTP_TIMEOUT_MS=15000

# --- Metricas e alertas ---
# Token opcional para GET /metrics. Sem token, a rota fica aberta.
METRICS_TOKEN=
# ALERT_WEBHOOK_URL=https://alerts.example.com/btc-payments
# ALERT_WEBHOOK_TOKEN=

# --- Ferramentas de dev (scripts/create-intent.ts) ---
# Saida de `npm run client:create` ou POST /admin/api/clients.
CLIENT_API_KEY=
CLIENT_REQUEST_SECRET=
