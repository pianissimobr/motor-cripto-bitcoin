# ============================================================
# btc-payments - variaveis de ambiente (NUNCA commitar o .env)
# ============================================================

# --- Servidor HTTP ---
NODE_ENV=development
PORT=4580
HOST=0.0.0.0
LOG_LEVEL=debug
# Token do admin. Em producao: openssl rand -hex 32 (minimo 32 chars).
ADMIN_TOKEN=dev-admin-token-change-me
# So habilite atras de um proxy reverso confiavel.
TRUST_PROXY=false
# Lista separada por virgula, sem wildcard. Vazio = origem de PUBLIC_BASE_URL.
CORS_ALLOWED_ORIGINS=
PUBLIC_BASE_URL=http://localhost:4580

# --- Banco de dados ---
DATABASE_URL=postgres://btc:btc_dev_password@localhost:5434/btc_payments
DATABASE_SSL=false
TEST_DATABASE_URL=postgres://btc:btc_dev_password@localhost:5434/btc_payments_test
# DATABASE_SSL_CA=

# --- Criptografia de segredos ---
# Gere com: openssl rand -base64 32
DATA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# KEYRING={"k1":"<base64 32>","k2":"<base64 32>"}
# DATA_ACTIVE_KID=k1
# DATA_LEGACY_KID=k1

# --- Carteira Bitcoin (watch-only) ---
# bitcoin | testnet | regtest
BTC_NETWORK=regtest
# xpub DE CONTA BIP84: m/84'/0'/0' (depth 3). NUNCA use xprv/seed aqui.
# O tpub abaixo e derivado do mnemonic publico "abandon ... about".
# Serve APENAS para desenvolvimento em regtest. NUNCA use em mainnet.
BTC_XPUB=tpubDCxX2sYFS5bDkSe5GKKYHjBW7tgyN1R3UchpLJvdbf54ohxeGRtd8MbDUe1cguVHe4vnK68DsuD5MXjxi9EXx16rb9EnNsaF5KT99CinaJz
BTC_DERIVATION_PREFIX=0
BTC_MAX_INDEX=100000
BTC_GAP_LIMIT=20

# --- Intent / expiracao ---
# Lightning expira em 10 min; on-chain continua observado por 24h.
INTENT_TTL_SECONDS=600
INTENT_GRACE_SECONDS=86400
# TTL da cotacao fiat/BTC no checkout.
FX_QUOTE_TTL_SECONDS=600

# --- On-chain / Esplora ---
# ONCHAIN_ENABLED=false desliga o trilho on-chain; deixe as variaveis vazias.
ONCHAIN_ENABLED=true
# Em dev, use Nigiri/Esplora self-hosted. Nao use API publica em producao.
ESPLORA_URL=http://localhost:3002
ESPLORA_TIMEOUT_MS=10000
ONCHAIN_CONFIRMATIONS=1
ONCHAIN_HIGH_VALUE_SATS=1000000
ONCHAIN_HIGH_VALUE_CONFIRMATIONS=3

# --- LNbits ---
# LIGHTNING_ENABLED=false desliga o Lightning; deixe as variaveis vazias.
LIGHTNING_ENABLED=true
# Crie uma wallet no LNbits (FakeWallet em dev) e copie a Invoice Key.
LNBITS_URL=http://localhost:5001
LNBITS_API_KEY=
LNBITS_WEBHOOK_TOKEN=dev-webhook-token-change-me
# URL que o container do LNbits usa para alcançar esta API (webhook de entrada).
# Fora do Docker, use a mesma PUBLIC_BASE_URL.
LNBITS_WEBHOOK_BASE_URL=http://host.docker.internal:4580

# --- Sweep automatico ---
SWEEP_ENABLED=true
# Endereco da carteira fria. Precisa ser da mesma rede de BTC_NETWORK.
# O endereco abaixo e derivado do mnemonic publico, apenas para regtest.
COLD_WALLET_ADDRESS=bcrt1qnjg0jd8228aq7egyzacy8cys3knf9xvr3v5hfj
# Treasury BTC que recebe as varreduras. Se vazio, usa COLD_WALLET_ADDRESS.
TREASURY_BTC_ADDRESS=
# Carteira quente USDC na Base (opcional nesta fase).
TREASURY_USDC_ADDRESS=
# Carteira de gas ETH na Base (opcional nesta fase).
GAS_BASE_ADDRESS=
SWEEP_MIN_SATS=1000
SWEEP_FEE_TARGET_BLOCKS=6
SWEEP_FEE_MULTIPLIER=1.0
SWEEP_MAX_FEE_PCT=0.1
# RBF depois de 10 min sem confirmacao; maximo de 3 reenvios.
SWEEP_RBF_AFTER_SECONDS=600
SWEEP_MAX_ATTEMPTS=3

# --- Signer do sweep ---
# local  = keystore cifrado no worker (dev / operacao pequena)
# remote = signer HTTP externo (producao)
# psbt   = assinatura manual em hardware wallet
SIGNER_MODE=local
SIGNER_KEYSTORE_PATH=./data/keystore.json
SIGNER_PASSPHRASE=dev-passphrase-change-me
# SIGNER_REMOTE_URL=
# SIGNER_REMOTE_TOKEN=

# --- Conversao BTC -> USDC Base (THORChain) ---
# Desligado por padrao no dev; ligue quando tiver treasury e endpoints.
CONVERSION_ENABLED=false
THORCHAIN_URLS=https://thornode.ninerealms.com,https://thornode.thorswap.net
THORCHAIN_TIMEOUT_MS=15000
CONVERSION_MIN_CONFIRMATIONS=3
CONVERSION_MIN_SATS=10000
CONVERSION_SLIPPAGE_BPS=100
CONVERSION_QUOTE_TOLERANCE_BPS=50
CONVERSION_MAX_ATTEMPTS=3
# Senhador remoto que gasta a treasury BTC e devolve raw tx assinado.
# TREASURY_BTC_SIGNER_URL=
# TREASURY_BTC_SIGNER_TOKEN=
# Bridge HTTP para sacar o saldo Lightning da LNbits para a treasury BTC.
# LNBITS_WITHDRAWAL_URL=
# LNBITS_WITHDRAWAL_TOKEN=

# --- Payout USDC na Base ---
PAYOUT_ENABLED=false
BASE_RPC_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com
BASE_CHAIN_ID=8453
BASE_USDC_ADDRESS=0x833589fCD6EDB6E08F4C7C32D4f71b54BDA02913
# local: chave no worker; remoto: use PAYOUT_SIGNER_URL.
# BASE_PAYOUT_PRIVATE_KEY=
# PAYOUT_HOT_ADDRESS=
# PAYOUT_SIGNER_URL=
# PAYOUT_SIGNER_TOKEN=
PAYOUT_CONFIRMATIONS=1
PAYOUT_NEW_WALLET_CARE_SECONDS=86400
PAYOUT_MAX_ATTEMPTS=3
PAYOUT_USD_BRL_RATE_CENTS=540
PAYOUT_MIN_GAS_WEI=100000000000000

# --- PIX -> USDC Base (Lunium) ---
# Desligado por padrao. Use lun_test_ no sandbox e lun_live_ em producao.
PIX_ENABLED=false
LUNIUM_API_URL=https://api.luniumpay.com
LUNIUM_API_KEY=
LUNIUM_WEBHOOK_SECRET=
LUNIUM_TIMEOUT_MS=15000
PIX_ASSET=usdc
PIX_CHAIN=base
PIX_MIN_BRL_CENTS=2500
PIX_MAX_BRL_CENTS=25000000
PIX_VERIFY_SETTLEMENT_TX=true

# --- Webhooks de saida ---
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6

# --- Rate limit ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Jobs do worker ---
JOBS_LIGHTNING_RECONCILE_MS=15000
JOBS_EXPIRY_POLL_MS=10000
JOBS_ONCHAIN_POLL_MS=15000
JOBS_WEBHOOK_POLL_MS=10000
JOBS_SWEEP_POLL_MS=30000
JOBS_CONVERSION_POLL_MS=30000
JOBS_PAYOUT_POLL_MS=30000
JOBS_PIX_POLL_MS=30000
JOBS_RECONCILIATION_MS=86400000
JOBS_BATCH_SIZE=50

# --- Metricas e alertas ---
# Token opcional para GET /metrics. Sem token, a rota fica aberta.
METRICS_TOKEN=
# ALERT_WEBHOOK_URL=https://alerts.example.com/btc-payments
# ALERT_WEBHOOK_TOKEN=

# --- Ferramentas de dev (scripts/create-intent.ts) ---
# Saida de `npm run client:create` ou POST /admin/api/clients.
CLIENT_API_KEY=
CLIENT_REQUEST_SECRET=
