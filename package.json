{
  "name": "motor-cripto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Motor API-only de pagamentos on-chain: link Ramp -> HD Wallet -> sweep para carteira allowlisted do cliente",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "tsx src/worker/index.ts",
    "worker:start": "node dist/worker/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "drizzle-kit migrate",
    "migrate:generate": "drizzle-kit generate",
    "seed": "tsx scripts/seed.ts",
    "wallet:init": "tsx scripts/init-wallet.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "drizzle-orm": "0.45.4",
    "ethers": "6.17.0",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "postgres": "3.4.9",
    "qrcode": "^1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "0.31.11",
    "fast-check": "^4.10.2",
    "pino-pretty": "13.1.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
